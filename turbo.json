{
    "$schema": "https://turbo.build/repo/schema.json",
    "ui": "stream",
    "tasks": {
      "build": {
        "dependsOn": ["^build"],
        "inputs": ["$TURBO_DEFAULT$", ".env*"],
        "outputs": [".next/**", "!.next/cache/**", "dist/**"]
      },
      "lint": {
        "dependsOn": ["^lint"]
      },
      "dev": {
        "cache": false,
        "persistent": true
      },
      "start": {
        "dependsOn": ["build"]
      },
      "create-module": {
        "cache": false
      },
      "migrate": {
        "dependsOn": ["build"],
        "cache": false
      }
    }
  }